# Firebase web app config — copy this file to `.env` and fill in real values.
# Get these from Firebase Console → Project settings → General → Your apps → SDK setup.
# NOTE: these are client-side identifiers, not secrets, but keep .env out of git anyway.
# Access control is enforced by Firestore security rules (locked to your UID).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
