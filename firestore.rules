rules_version = '2';

// No-login, single-user app. Data lives under users/me/**.
//
// WARNING: with no authentication there is no way to tie access to a person, so
// these rules allow open read/write to this one path. Anyone who has the app's
// (public) Firebase config can read and write your tracker data. This is the
// deliberate trade-off for "enter without login". Everything outside users/me
// is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/me/{document=**} {
      allow read, write: if true;
    }
  }
}
